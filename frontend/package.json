{
    "name": "my-workspace",
    "private": true,
    "workspaces": [
        "sync-client",
        "obsidian-plugin",
        "test-client",
        "deterministic-tests",
        "local-client-cli"
    ],
    "prettier": {
        "trailingComma": "none",
        "tabWidth": 4,
        "useTabs": false,
        "endOfLine": "lf"
    },
    "scripts": {
        "build": "npm run build --workspaces",
        "dev": "concurrently --kill-others \"npm run dev -w sync-client\" \"npm run dev -w obsidian-plugin\"",
        "test": "npm run test --workspaces",
        "check:harness": "tsc --noEmit -p test-support/tsconfig.json && tsc --noEmit -p deterministic-tests/tsconfig.json && tsc --noEmit -p test-client/tsconfig.json",
        "test:harness": "npm run check:harness && tsx --test 'test-support/harness.test.ts' 'test-support/oracle-regressions.test.ts' 'test-support/recovery.test.ts' 'test-support/file-application.test.ts' 'test-support/observer.test.ts' 'test-support/event-delivery.test.ts' 'test-support/polling.test.ts' 'test-support/engine-regressions.test.ts' 'test-support/sync-audit.test.ts' 'test-client/src/**/*.test.ts' '../scripts/e2e-runner.test.mjs'",
        "test:protocol": "tsx --test 'test-support/protocol.test.ts' 'test-support/restart-reconciliation.test.ts' 'test-support/content-limits.test.ts' 'test-support/server-restore.test.ts' 'test-support/protocol-audit.test.ts' 'test-support/real-disk.test.ts' 'test-support/production-adapters.test.ts'",
        "lint": "eslint --fix sync-client obsidian-plugin test-client deterministic-tests local-client-cli && prettier --write \"**/*.ts\"",
        "update": "ncu -u -ws"
    },
    "devDependencies": {
        "concurrently": "^9.2.1",
        "eclint": "^2.8.1",
        "eslint": "9.38.0",
        "eslint-plugin-unused-imports": "^4.1.4",
        "npm-check-updates": "^19.1.1",
        "prettier": "^3.6.2",
        "typescript-eslint": "8.41.0"
    }
}
